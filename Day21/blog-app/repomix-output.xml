  --color-warning: #f59e0b;
  --color-warning-content: #111827;
  --color-error: #ef4444;
  --color-error-content: #ffffff;
  --radius-selector: 0.75rem;
  --radius-field: 0.75rem;
  --radius-box: 1rem;
  --size-selector: 0.25rem;
  --size-field: 0.25rem;
  --border: 1px;
  --depth: 1;
  --noise: 0;
}

@layer base {
  html {
    scrollbar-gutter: stable;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    background: var(--color-base-200);
    color: var(--color-base-content);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }
}

@layer components {
  .app-shell {
    min-height: 100vh;
    background: var(--color-base-200);
    color: var(--color-base-content);
  }

  .premium-card {
    border: 3px solid var(--color-base-300);
    background: color-mix(in oklab, var(--color-base-100) 94%, var(--color-primary) 6%);
    box-shadow: 0 18px 45px color-mix(in oklab, #000000 14%, transparent);
  }

  .premium-input {
    border-color: var(--color-base-300);
    background: var(--color-base-100);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      background-color 160ms ease;
  }

  .premium-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-primary) 24%, transparent);
    outline: none;
  }

  .page-container {
    width: min(100% - 3rem, 78rem);
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .page-container {
      width: min(100% - 2rem, 78rem);
    }
  }
}

/* Default: light theme is the app's default, so light image shows first */
.theme-img-light {
  display: block;
}
.theme-img-dark {
  display: none;
}

/* When html has data-theme="dark", flip which image shows */
:root[data-theme="dark"] .theme-img-light {
  display: none;
}
:root[data-theme="dark"] .theme-img-dark {
  display: block;
}
