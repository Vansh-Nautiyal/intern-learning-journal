                <li key={tag}>
                  <button
                    onClick={() => setSelectedTag(tag)}
                    className={`w-full rounded-lg px-3 py-2 text-left whitespace-normal break-words transition-colors ${
                      selectedTag === tag
                        ? "bg-primary text-primary-content"
                        : "hover:bg-base-200"
                    }`}
                  >
                    {tag.charAt(0).toUpperCase() + tag.slice(1)}
                  </button>
