  return (
    <>
      {/* Overlay */}
      <div
        onClick={closeSidebar}
        className={`fixed inset-0 z-[55] bg-neutral/60 backdrop-blur-sm transition-opacity duration-300 ${
          isSidebarOpen ? "opacity-65 pointer-events-auto" : "opacity-0 pointer-events-none"
